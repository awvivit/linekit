{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": [
    "dist",
    "coverage",
    "playwright-report",
    "test-results",
    "blob-report",
    "tmp"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["error", { "allowConstantExport": true }]
  }
}
